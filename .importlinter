[importlinter]
root_package = samepage
include_external_packages = True

[importlinter:contract:pure-core]
name = domain and engine stay free of Django and of the web layers
type = forbidden
source_modules =
    samepage.domain
    samepage.engine
forbidden_modules =
    django
    rest_framework
    samepage.apps
    samepage.core
    samepage.services
    samepage.ops
